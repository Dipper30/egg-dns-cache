    "lint": "eslint .",
    "ci": "npm run lint && npm run cov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dipper30/egg-dns-cache.git"
  },
  "bugs": {
    "url": "https://github.com/Dipper30/egg-dns-cache/issues"
